# Match the browser origin; set the production HTTPS domain when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Live database mode is the default. Explicit demo mode never accepts real reservations.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix either of these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Generate a random secret of at least 32 characters; keep stable for booking retries.
BOOKING_ACCESS_SECRET=
# Leave false until approved content, schema and production QA are complete.
SITE_INDEXING_ENABLED=false
# Optional: only needed for a place-ID map embed without verified coordinates.
# Restrict this public key to the Maps Embed API and the approved website origins.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# Payment, email, OTA and Google Business APIs are deliberately not activated by placeholder keys.

# Official footer social profiles (HTTPS URLs); unset links lead to contact enquiries.
NEXT_PUBLIC_HOTEL_INSTAGRAM_URL=
NEXT_PUBLIC_HOTEL_FACEBOOK_URL=
NEXT_PUBLIC_HOTEL_WHATSAPP_URL=
